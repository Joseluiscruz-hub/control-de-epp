# ============================================
# CONTROL DE EPP — Variables de Entorno
# Copia este archivo como .env.local y rellena los valores
# ============================================

# --- Firebase Configuration ---
# Obtén estos valores en: https://console.firebase.google.com/
# Proyecto → Configuración del proyecto → Tus aplicaciones → Config SDK

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123:web:abc123
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firestore Database ID (si usas una DB diferente a "(default)")
# Déjalo vacío o como "(default)" si usas la base de datos por defecto
NEXT_PUBLIC_FIREBASE_DATABASE_ID=(default)

# --- Google Gemini API Key (para el Chatbot ARIA) ---
# Obtén tu API Key GRATIS en: https://aistudio.google.com/app/apikey
# ⚠️ IMPORTANTE: Esta variable NO tiene prefijo NEXT_PUBLIC_ para que sea segura (solo servidor)
GEMINI_API_KEY=AIzaSy...

# --- Kiosko Session Secret ---
# Se usa para firmar la sesión segura del kiosko después de validar el PIN.
# Debe tener mínimo 32 caracteres y configurarse como GitHub Actions Secret en producción.
KIOSK_SESSION_SECRET=cambia-este-secreto-de-32-caracteres-minimo

# --- Administradores ---
# Emails de Google separados por comas que tendrán acceso admin al panel
# ⚠️ IMPORTANTE: Usa el email exacto con el que el usuario inicia sesión en Google
NEXT_PUBLIC_ADMIN_EMAILS=mimonkb222@gmail.com,otroadmin@gmail.com

# --- Modo Desarrollador ---
# Emails autorizados para abrir el panel de diagnóstico avanzado.
NEXT_PUBLIC_DEVELOPER_EMAILS=mimonkb222@gmail.com
