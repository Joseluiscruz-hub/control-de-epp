rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Empleados ──────────────────────────────────────────────────────────
    match /employees/{employeeId} {
      allow read: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create: if request.auth != null && isAdmin() && canWritePlant(request.resource.data) && isValidEmployee(request.resource.data);
      allow update: if request.auth != null && isAdmin() && canWritePlant(request.resource.data) && isValidEmployee(request.resource.data);
      allow delete: if false;
    }

    // ── Snapshot público mínimo para kiosko ────────────────────────────────
    match /kiosk_employees/{employeeId} {
      allow get: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow list: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create: if request.auth != null && isAdmin() && canWritePlant(request.resource.data) && isValidKioskEmployeeSnapshot(request.resource.data);
      allow update: if request.auth != null && isAdmin() && canWritePlant(request.resource.data) && isValidKioskEmployeeSnapshot(request.resource.data);
      allow delete: if false;
    }

    // ── Secretos sensibles de kiosko (solo servidor Admin SDK) ─────────────
    match /kiosk_employee_secrets/{employeeId} {
      allow read, write: if false;
    }

    // ── Catálogo EPP ───────────────────────────────────────────────────────
    match /ppe_catalog/{itemId} {
      allow read: if request.auth != null && hasPlantAccess(resource.data);
      allow create, update, delete: if false;
    }

    // ── Catálogo público seguro para kiosko ────────────────────────────────
    match /kiosk_catalog/{itemId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ── Solicitudes Kiosko ─────────────────────────────────────────────────
    match /kiosk_requests/{requestId} {
      allow get: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow list: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create, update, delete: if false;
    }

    // ── Estado público mínimo de solicitud para kiosko ─────────────────────
    match /kiosk_request_status/{requestId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ── Alertas administrativas generadas por servidor ────────────────────
    match /kiosk_alerts/{alertId} {
      allow read: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create, update, delete: if false;
    }

    // ── Bitácora de movimientos de inventario ─────────────────────────────
    match /inventory_movements/{movementId} {
      allow read: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create, update, delete: if false;
    }

    // ── Asignaciones ───────────────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create, update, delete: if false;
    }

    // ── Metas y acumulados presupuestales ─────────────────────────────────
    match /budget_goals/{goalId} {
      allow read: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create, update: if request.auth != null && isGlobalAdmin() && isValidBudgetGoal(request.resource.data);
      allow delete: if false;
    }

    match /budget_spending/{counterId} {
      allow read: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow write: if false;
    }

    // ── Cobros por Extravío ─────────────────────────────────────────────────
    match /loss_charges/{chargeId} {
      allow read: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create, update, delete: if false;
    }

    // ── Sesiones Kiosko ─────────────────────────────────────────────────────
    match /kiosk_sessions/{sessionId} {
      allow read, write: if request.auth != null && (isAdmin() || isKioskSessionOwner(sessionId));
    }

    // ── Perfiles administrativos multi-planta ─────────────────────────────
    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isBootstrapAdmin());
      allow list: if request.auth != null && isGlobalAdmin();
      allow create, update: if request.auth != null && isGlobalAdmin() && isValidUserProfile(request.resource.data, userId);
      allow delete: if false;
    }

    // ── Auditoria de rescate administrativo ───────────────────────────────
    match /admin_rescue_events/{eventId} {
      allow read: if request.auth != null && isGlobalAdmin();
      allow create, update, delete: if false;
    }

    // ── Auditoría central generada por servidor ───────────────────────────
    match /audit_events/{eventId} {
      allow read: if request.auth != null && isGlobalAdmin();
      allow create, update, delete: if false;
    }

    // ── Controles internos de rate limit (solo servidor Admin SDK) ──────────
    match /kiosk_pin_rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /public_api_rate_limits/{limitId} {
      allow read, write: if false;
    }

    // ── Funciones helper ───────────────────────────────────────────────────

    function isBootstrapAdmin() {
      return request.auth != null && request.auth.token.bootstrapAdmin == true;
    }

    function userProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return request.auth != null && exists(userProfilePath());
    }

    function getUserData() {
      return get(userProfilePath()).data;
    }

    function isGlobalAdmin() {
      return isBootstrapAdmin()
        || (hasUserProfile()
          && getUserData().active != false
          && getUserData().role == "admin_global");
    }

    function isLocalAdmin() {
      return hasUserProfile()
        && getUserData().active != false
        && getUserData().role == "admin_local"
        && getUserData().plantaId in ["cuautitlan", "toluca"];
    }

    function isAdmin() {
      return isGlobalAdmin() || isLocalAdmin();
    }

    function activeAdminPlant() {
      return isLocalAdmin() ? getUserData().plantaId : "nacional";
    }

    function hasPlantAccess(data) {
      return isGlobalAdmin()
        || (isLocalAdmin() && (data.plantaId == null || data.plantaId == activeAdminPlant()));
    }

    function canWritePlant(data) {
      return isGlobalAdmin()
        || (isLocalAdmin() && data.plantaId == activeAdminPlant());
    }

    function isValidPlantScope(value) {
      return value in ["cuautitlan", "toluca", "nacional"];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasOnly([
          "uid", "email", "role", "plantaId", "displayName", "employeeId", "permissions",
          "active", "source", "createdAt", "updatedAt"
        ])
        && data.keys().hasAll(["uid", "email", "role", "plantaId", "active"])
        && data.uid == userId
        && data.email is string && data.email.size() > 3
        && data.role in ["admin_local", "admin_global"]
        && isValidPlantScope(data.plantaId)
        && (data.role == "admin_global" || data.plantaId in ["cuautitlan", "toluca"])
        && data.active is bool
        && optionalString(data.displayName)
        && optionalString(data.source)
        && optionalEmployeeId(data.employeeId)
        && isValidAdminPermissions(data.permissions)
        && (data.createdAt == null || data.createdAt is timestamp)
        && (data.updatedAt == null || data.updatedAt is timestamp);
    }

    function optionalEmployeeId(value) {
      return value == null || (value is string && value.matches("^[0-9]{1,12}$"));
    }

    function isValidAdminPermissions(value) {
      return value == null
        || (
          value is map
          && value.keys().hasOnly(["canApproveKioskRequests", "canApproveKioskAlerts"])
          && (value.canApproveKioskRequests == null || value.canApproveKioskRequests is bool)
          && (value.canApproveKioskAlerts == null || value.canApproveKioskAlerts is bool)
        );
    }

    function isValidBudgetGoal(data) {
      return data.keys().hasOnly([
          "plantaId", "year", "annualLimit", "monthlyLimits", "alertThresholds", "currency",
          "createdAt", "updatedAt", "createdBy", "updatedBy"
        ])
        && data.keys().hasAll([
          "plantaId", "year", "annualLimit", "alertThresholds", "currency", "updatedAt", "updatedBy"
        ])
        && isValidPlantScope(data.plantaId)
        && data.year is int && data.year >= 2020 && data.year <= 2100
        && data.annualLimit is number && data.annualLimit > 0
        && (data.monthlyLimits == null || data.monthlyLimits is map)
        && data.alertThresholds is list && data.alertThresholds.size() > 0 && data.alertThresholds.size() <= 5
        && data.currency == "MXN"
        && (data.createdAt == null || data.createdAt is timestamp)
        && data.updatedAt is timestamp
        && optionalString(data.createdBy)
        && data.updatedBy is string && data.updatedBy.size() > 0;
    }

    function isValidEmployee(data) {
      return data.keys().hasOnly([
          "id", "name", "area", "active", "firstLogin", "termsAccepted", "termsAcceptedAt",
          "createdAt", "updatedAt", "division", "personnelArea", "plantArea", "costCenter",
          "positionId", "position", "jobFunction", "hireDate", "sex", "source", "schemaVersion",
          "rfc", "imss", "curp", "plantaId", "credentialResetAt", "credentialResetByUid",
          "credentialResetByEmail"
        ])
        && data.keys().hasAll(["id", "name", "area", "active", "createdAt", "updatedAt"])
        && data.id is string && data.id.size() > 0
        && data.name is string && data.name.size() > 0
        && data.area is string && data.area.size() > 0
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.firstLogin == null || data.firstLogin is bool)
        && (data.termsAccepted == null || data.termsAccepted is bool)
        && (data.termsAcceptedAt == null || data.termsAcceptedAt is timestamp)
        && (data.credentialResetAt == null || data.credentialResetAt is timestamp)
        && optionalString(data.credentialResetByUid)
        && optionalString(data.credentialResetByEmail)
        && optionalString(data.division)
        && optionalString(data.personnelArea)
        && optionalString(data.plantArea)
        && optionalString(data.costCenter)
        && optionalString(data.positionId)
        && optionalString(data.position)
        && optionalString(data.jobFunction)
        && optionalString(data.hireDate)
        && optionalString(data.sex)
        && optionalString(data.source)
        && (data.plantaId == null || data.plantaId in ["cuautitlan", "toluca"])
        && optionalString(data.rfc)
        && optionalString(data.imss)
        && optionalString(data.curp)
        && (data.schemaVersion == null || data.schemaVersion is int);
    }

    function isValidKioskEmployeeSnapshot(data) {
      return data.keys().hasOnly([
          "id", "name", "area", "active", "firstLogin", "termsAccepted", "termsAcceptedAt", "createdAt",
          "updatedAt", "personnelArea", "plantArea", "position", "jobFunction", "source", "schemaVersion",
          "plantaId", "credentialResetAt", "credentialResetByUid", "credentialResetByEmail"
        ])
        && data.keys().hasAll(["name", "active", "updatedAt"])
        && data.name is string && data.name.size() > 0
        && data.active is bool
        && data.updatedAt is timestamp
        && optionalString(data.id)
        && (data.createdAt == null || data.createdAt is timestamp)
        && (data.firstLogin == null || data.firstLogin is bool)
        && (data.termsAccepted == null || data.termsAccepted is bool)
        && (data.credentialResetAt == null || data.credentialResetAt is timestamp)
        && optionalString(data.credentialResetByUid)
        && optionalString(data.credentialResetByEmail)
        && optionalString(data.area)
        && optionalString(data.personnelArea)
        && optionalString(data.plantArea)
        && optionalString(data.position)
        && optionalString(data.jobFunction)
        && optionalString(data.source)
        && (data.plantaId == null || data.plantaId in ["cuautitlan", "toluca"])
        && (data.termsAcceptedAt == null || data.termsAcceptedAt is timestamp)
        && (data.schemaVersion == null || data.schemaVersion is int);
    }

    function isKioskSessionOwner(sessionId) {
      return sessionId == request.auth.uid
        || (resource != null && resource.data.uid == request.auth.uid)
        || (request.resource != null && request.resource.data.uid == request.auth.uid);
    }

    function optionalString(value) {
      return value == null || value is string;
    }
  }
}
