rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Empleados ──────────────────────────────────────────────────────────
    match /employees/{employeeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isValidEmployee(request.resource.data);
      allow update: if request.auth != null && (
        // Admin puede actualizar todo
        isAdmin() ||
        // El kiosko solo puede actualizar campos de PIN/T&C del propio empleado
        (onlyUpdatingKioskFields(request.resource.data, resource.data))
      );
      allow delete: if false;
    }

    // ── Snapshot público mínimo para kiosko ────────────────────────────────
    match /kiosk_employees/{employeeId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && isAdmin();
      allow update: if (request.auth != null && isAdmin()) || isValidFirstKioskSetup(request.resource.data, resource.data);
      allow delete: if false;
    }

    // ── Catálogo EPP ───────────────────────────────────────────────────────
    match /ppe_catalog/{itemId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isAdmin();
      allow delete: if false;
    }

    // ── Catálogo público seguro para kiosko ────────────────────────────────
    match /kiosk_catalog/{itemId} {
      allow read: if true;
      allow create, update: if request.auth != null && isAdmin();
      allow delete: if false;
    }

    // ── Solicitudes Kiosko ─────────────────────────────────────────────────
    match /kiosk_requests/{requestId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if isValidKioskRequest(request.resource.data);
      allow update: if request.auth != null && isAdmin() && onlyAdminUpdatingKioskRequestStatus(request.resource.data, resource.data);
      allow delete: if false;
    }

    // ── Estado público mínimo de solicitud para kiosko ─────────────────────
    match /kiosk_request_status/{requestId} {
      allow get: if true;
      allow list: if false;
      allow create: if isValidKioskRequestStatus(request.resource.data, requestId);
      allow update: if request.auth != null && isAdmin() && isValidKioskRequestStatus(request.resource.data, requestId);
      allow delete: if false;
    }

    // ── Asignaciones ───────────────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isValidAssignment(request.resource.data);
      allow update: if request.auth != null && (
        isAdmin() ||
        // Solo se puede cambiar status de pending_review a active/cancelled
        onlyUpdatingStatus(request.resource.data, resource.data)
      );
      allow delete: if false;
    }

    // ── Cobros por Extravío ─────────────────────────────────────────────────
    match /loss_charges/{chargeId} {
      allow read: if request.auth != null && isAdmin();
      allow create: if request.auth != null && isValidLossCharge(request.resource.data);
      allow update: if request.auth != null && isAdmin();
      allow delete: if false;
    }

    // ── Sesiones Kiosko ─────────────────────────────────────────────────────
    match /kiosk_sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    // ── Funciones helper ───────────────────────────────────────────────────

    function isAdmin() {
      // Lista de administradores autorizados
      // Para agregar admins: añade el email de Google del usuario a esta lista
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          '141293124+joseluiscruz-hub@users.noreply.github.com'
          // Agrega más emails separados por comas
        ];
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(["name", "area", "active", "createdAt"])
        && data.name is string && data.name.size() > 0
        && data.area is string
        && data.active is bool;
    }

    function onlyUpdatingKioskFields(newData, oldData) {
      // Permite que el kiosko actualice solo: pin, firstLogin, termsAccepted, termsAcceptedAt, updatedAt
      let allowedFields = ["pin", "firstLogin", "termsAccepted", "termsAcceptedAt", "updatedAt"];
      let changedFields = newData.diff(oldData).affectedKeys();
      return changedFields.hasOnly(allowedFields);
    }

    function isValidFirstKioskSetup(newData, oldData) {
      let changedFields = newData.diff(oldData).affectedKeys();
      return oldData.active == true
        && oldData.firstLogin == true
        && oldData.termsAccepted == false
        && changedFields.hasOnly(["pin", "firstLogin", "termsAccepted", "termsAcceptedAt", "updatedAt"])
        && newData.active == oldData.active
        && newData.name == oldData.name
        && newData.pin is string
        && newData.pin.size() >= 8
        && newData.firstLogin == false
        && newData.termsAccepted == true
        && newData.termsAcceptedAt is timestamp
        && newData.updatedAt is timestamp;
    }

    function isValidAssignment(data) {
      return data.keys().hasAll(["employeeId", "sku", "size", "assignedAt", "nextReplacementAt", "status", "issuedByUserId"])
        && data.status in ["active", "pending_review", "replaced", "returned"]
        && (data.replacementReason == null || data.replacementReason in ["vida_util", "desgaste", "extravio"])
        && (data.chargeAmount == null || (data.chargeAmount is number && data.chargeAmount >= 0));
    }

    function onlyUpdatingStatus(newData, oldData) {
      let changedFields = newData.diff(oldData).affectedKeys();
      return changedFields.hasOnly(["status", "updatedAt"]);
    }

    function isValidLossCharge(data) {
      return data.keys().hasAll(["assignmentId", "employeeId", "sku", "chargeAmount", "createdAt", "status"])
        && data.chargeAmount is number && data.chargeAmount > 0
        && data.status in ["pending_payroll", "applied", "cancelled"];
    }

    function isValidKioskRequest(data) {
      return data.keys().hasOnly(["employeeId", "employeeName", "items", "status", "createdAt", "updatedAt", "source"])
        && data.keys().hasAll(["employeeId", "employeeName", "items", "status", "createdAt", "updatedAt", "source"])
        && data.employeeId is string && data.employeeId.size() > 0
        && data.employeeName is string && data.employeeName.size() > 0
        && exists(/databases/$(database)/documents/kiosk_employees/$(data.employeeId))
        && get(/databases/$(database)/documents/kiosk_employees/$(data.employeeId)).data.active == true
        && get(/databases/$(database)/documents/kiosk_employees/$(data.employeeId)).data.name == data.employeeName
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 10
        && areValidKioskRequestItems(data.items)
        && data.status == "pending"
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.source == "kiosk";
    }

    function areValidKioskRequestItems(items) {
      return (items.size() < 1 || isValidKioskRequestItem(items[0]))
        && (items.size() < 2 || isValidKioskRequestItem(items[1]))
        && (items.size() < 3 || isValidKioskRequestItem(items[2]))
        && (items.size() < 4 || isValidKioskRequestItem(items[3]))
        && (items.size() < 5 || isValidKioskRequestItem(items[4]))
        && (items.size() < 6 || isValidKioskRequestItem(items[5]))
        && (items.size() < 7 || isValidKioskRequestItem(items[6]))
        && (items.size() < 8 || isValidKioskRequestItem(items[7]))
        && (items.size() < 9 || isValidKioskRequestItem(items[8]))
        && (items.size() < 10 || isValidKioskRequestItem(items[9]));
    }

    function isValidKioskRequestItem(item) {
      return item is map
        && item.keys().hasOnly(["itemId", "itemName", "sku", "size", "replacementDays"])
        && item.itemId is string && item.itemId.size() > 0
        && item.itemName is string && item.itemName.size() > 0
        && item.sku is string && item.sku.size() > 0
        && item.size is string && item.size.size() > 0
        && item.replacementDays is int && item.replacementDays > 0;
    }

    function onlyAdminUpdatingKioskRequestStatus(newData, oldData) {
      let changedFields = newData.diff(oldData).affectedKeys();
      return changedFields.hasOnly(["status", "updatedAt"])
        && newData.status in ["pending", "approved", "rejected"];
    }

    function isValidKioskRequestStatus(data, requestId) {
      return data.keys().hasOnly(["requestId", "status", "source", "updatedAt"])
        && data.keys().hasAll(["requestId", "status", "source", "updatedAt"])
        && data.requestId == requestId
        && data.status in ["pending", "approved", "rejected"]
        && data.source == "kiosk"
        && data.updatedAt is timestamp;
    }
  }
}
