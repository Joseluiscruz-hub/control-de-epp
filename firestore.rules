rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Empleados ──────────────────────────────────────────────────────────
    match /employees/{employeeId} {
      allow read: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create: if request.auth != null && isAdmin() && canWritePlant(request.resource.data) && isValidEmployee(request.resource.data);
      allow update: if request.auth != null && isAdmin() && canWritePlant(request.resource.data) && isValidEmployee(request.resource.data);
      allow delete: if false;
    }

    // ── Snapshot público mínimo para kiosko ────────────────────────────────
    match /kiosk_employees/{employeeId} {
      allow get: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow list: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create: if request.auth != null && isAdmin() && canWritePlant(request.resource.data) && isValidKioskEmployeeSnapshot(request.resource.data);
      allow update: if request.auth != null && isAdmin() && canWritePlant(request.resource.data) && isValidKioskEmployeeSnapshot(request.resource.data);
      allow delete: if false;
    }

    // ── Secretos sensibles de kiosko (solo servidor Admin SDK) ─────────────
    match /kiosk_employee_secrets/{employeeId} {
      allow read, write: if false;
    }

    // ── Catálogo EPP ───────────────────────────────────────────────────────
    match /ppe_catalog/{itemId} {
      allow read: if request.auth != null && hasPlantAccess(resource.data);
      allow create, update, delete: if false;
    }

    // ── Catálogo público seguro para kiosko ────────────────────────────────
    match /kiosk_catalog/{itemId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ── Solicitudes Kiosko ─────────────────────────────────────────────────
    match /kiosk_requests/{requestId} {
      allow get: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow list: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create, update, delete: if false;
    }

    // ── Estado público mínimo de solicitud para kiosko ─────────────────────
    match /kiosk_request_status/{requestId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ── Alertas administrativas generadas por servidor ────────────────────
    match /kiosk_alerts/{alertId} {
      allow read: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create, update, delete: if false;
    }

    // ── Bitácora de movimientos de inventario ─────────────────────────────
    match /inventory_movements/{movementId} {
      allow read: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create, update, delete: if false;
    }

    // ── Asignaciones ───────────────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create, update, delete: if false;
    }

    // ── Cobros por Extravío ─────────────────────────────────────────────────
    match /loss_charges/{chargeId} {
      allow read: if request.auth != null && isAdmin() && hasPlantAccess(resource.data);
      allow create, update, delete: if false;
    }

    // ── Sesiones Kiosko ─────────────────────────────────────────────────────
    match /kiosk_sessions/{sessionId} {
      allow read, write: if request.auth != null && (isAdmin() || isKioskSessionOwner(sessionId));
    }

    // ── Perfiles administrativos multi-planta ─────────────────────────────
    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if request.auth != null && isGlobalAdmin();
      allow create, update: if request.auth != null && isGlobalAdmin() && isValidUserProfile(request.resource.data, userId);
      allow delete: if false;
    }

    // ── Auditoria de rescate administrativo ───────────────────────────────
    match /admin_rescue_events/{eventId} {
      allow read: if request.auth != null && isGlobalAdmin();
      allow create, update, delete: if false;
    }

    // ── Auditoría central generada por servidor ───────────────────────────
    match /audit_events/{eventId} {
      allow read: if request.auth != null && isGlobalAdmin();
      allow create, update, delete: if false;
    }

    // ── Funciones helper ───────────────────────────────────────────────────

    function isBootstrapAdmin() {
      return request.auth != null && request.auth.token.bootstrapAdmin == true;
    }

    function userProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return request.auth != null && exists(userProfilePath());
    }

    function getUserData() {
      return get(userProfilePath()).data;
    }

    function isGlobalAdmin() {
      return isBootstrapAdmin()
        || (hasUserProfile()
          && getUserData().active != false
          && getUserData().role == "admin_global");
    }

    function isLocalAdmin() {
      return hasUserProfile()
        && getUserData().active != false
        && getUserData().role == "admin_local"
        && getUserData().plantaId in ["cuautitlan", "toluca"];
    }

    function isAdmin() {
      return isGlobalAdmin() || isLocalAdmin();
    }

    function activeAdminPlant() {
      return isLocalAdmin() ? getUserData().plantaId : "nacional";
    }

    function hasPlantAccess(data) {
      return isGlobalAdmin()
        || (isLocalAdmin() && (data.plantaId == null || data.plantaId == activeAdminPlant()));
    }

    function canWritePlant(data) {
      return isGlobalAdmin()
        || (isLocalAdmin() && data.plantaId == activeAdminPlant());
    }

    function isValidPlantScope(value) {
      return value in ["cuautitlan", "toluca", "nacional"];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasOnly(["uid", "email", "role", "plantaId", "displayName", "active", "createdAt", "updatedAt"])
        && data.keys().hasAll(["uid", "email", "role", "plantaId", "active"])
        && data.uid == userId
        && data.email is string && data.email.size() > 3
        && data.role in ["admin_local", "admin_global"]
        && isValidPlantScope(data.plantaId)
        && (data.role == "admin_global" || data.plantaId in ["cuautitlan", "toluca"])
        && data.active is bool
        && optionalString(data.displayName)
        && (data.createdAt == null || data.createdAt is timestamp)
        && (data.updatedAt == null || data.updatedAt is timestamp);
    }

    function isValidEmployee(data) {
      return data.keys().hasOnly([
          "id", "name", "area", "active", "firstLogin", "termsAccepted", "termsAcceptedAt",
          "createdAt", "updatedAt", "division", "personnelArea", "plantArea", "costCenter",
          "positionId", "position", "jobFunction", "hireDate", "sex", "source", "schemaVersion",
          "rfc", "imss", "curp", "plantaId"
        ])
        && data.keys().hasAll(["id", "name", "area", "active", "createdAt", "updatedAt"])
        && data.id is string && data.id.size() > 0
        && data.name is string && data.name.size() > 0
        && data.area is string && data.area.size() > 0
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.firstLogin == null || data.firstLogin is bool)
        && (data.termsAccepted == null || data.termsAccepted is bool)
        && (data.termsAcceptedAt == null || data.termsAcceptedAt is timestamp)
        && optionalString(data.division)
        && optionalString(data.personnelArea)
        && optionalString(data.plantArea)
        && optionalString(data.costCenter)
        && optionalString(data.positionId)
        && optionalString(data.position)
        && optionalString(data.jobFunction)
        && optionalString(data.hireDate)
        && optionalString(data.sex)
        && optionalString(data.source)
        && (data.plantaId == null || data.plantaId in ["cuautitlan", "toluca"])
        && optionalString(data.rfc)
        && optionalString(data.imss)
        && optionalString(data.curp)
        && (data.schemaVersion == null || data.schemaVersion is int);
    }

    function isValidKioskEmployeeSnapshot(data) {
      return data.keys().hasOnly([
          "id", "name", "area", "active", "firstLogin", "termsAccepted", "termsAcceptedAt", "createdAt",
          "updatedAt", "personnelArea", "plantArea", "position", "jobFunction", "source", "schemaVersion", "plantaId"
        ])
        && data.keys().hasAll(["name", "active", "updatedAt"])
        && data.name is string && data.name.size() > 0
        && data.active is bool
        && data.updatedAt is timestamp
        && optionalString(data.id)
        && (data.createdAt == null || data.createdAt is timestamp)
        && (data.firstLogin == null || data.firstLogin is bool)
        && (data.termsAccepted == null || data.termsAccepted is bool)
        && optionalString(data.area)
        && optionalString(data.personnelArea)
        && optionalString(data.plantArea)
        && optionalString(data.position)
        && optionalString(data.jobFunction)
        && optionalString(data.source)
        && (data.plantaId == null || data.plantaId in ["cuautitlan", "toluca"])
        && (data.termsAcceptedAt == null || data.termsAcceptedAt is timestamp)
        && (data.schemaVersion == null || data.schemaVersion is int);
    }

    function isKioskSessionOwner(sessionId) {
      return sessionId == request.auth.uid
        || (resource != null && resource.data.uid == request.auth.uid)
        || (request.resource != null && request.resource.data.uid == request.auth.uid);
    }

    function optionalString(value) {
      return value == null || value is string;
    }

    function isValidAssignment(data) {
      return data.keys().hasAll(["employeeId", "sku", "size", "assignedAt", "nextReplacementAt", "status", "issuedByUserId"])
        && data.status in ["active", "pending_review", "replaced", "returned"]
        && (data.plantaId == null || data.plantaId in ["cuautitlan", "toluca"])
        && (data.replacementReason == null || data.replacementReason in ["vida_util", "desgaste", "extravio"])
        && (data.chargeAmount == null || (data.chargeAmount is number && data.chargeAmount >= 0));
    }

    function onlyUpdatingStatus(newData, oldData) {
      let changedFields = newData.diff(oldData).affectedKeys();
      return changedFields.hasOnly(["status", "updatedAt"]);
    }

    function isValidLossCharge(data) {
      return data.keys().hasAll(["assignmentId", "employeeId", "sku", "chargeAmount", "createdAt", "status"])
        && data.chargeAmount is number && data.chargeAmount > 0
        && (data.plantaId == null || data.plantaId in ["cuautitlan", "toluca"])
        && data.status in ["pending_payroll", "applied", "cancelled"];
    }

    function isValidKioskRequest(data) {
      return data.keys().hasOnly([
          "employeeId", "employeeName", "employeeArea", "plantaId", "items", "status",
          "createdAt", "updatedAt", "source", "hasEarlyReplacementAlert",
          "earlyReplacementWarnings", "earlyReplacementAlertIds"
        ])
        && data.keys().hasAll(["employeeId", "employeeName", "items", "status", "createdAt", "updatedAt", "source"])
        && data.employeeId is string && data.employeeId.size() > 0
        && data.employeeName is string && data.employeeName.size() > 0
        && optionalString(data.employeeArea)
        && (data.plantaId == null || data.plantaId in ["cuautitlan", "toluca"])
        && exists(/databases/$(database)/documents/kiosk_employees/$(data.employeeId))
        && get(/databases/$(database)/documents/kiosk_employees/$(data.employeeId)).data.active == true
        && get(/databases/$(database)/documents/kiosk_employees/$(data.employeeId)).data.name == data.employeeName
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 10
        && areValidKioskRequestItems(data.items)
        && data.status == "pending"
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.hasEarlyReplacementAlert == null || data.hasEarlyReplacementAlert is bool)
        && (data.earlyReplacementWarnings == null || data.earlyReplacementWarnings is list)
        && (data.earlyReplacementAlertIds == null || data.earlyReplacementAlertIds is list)
        && data.source == "kiosk";
    }

    function areValidKioskRequestItems(items) {
      return (items.size() < 1 || isValidKioskRequestItem(items[0]))
        && (items.size() < 2 || isValidKioskRequestItem(items[1]))
        && (items.size() < 3 || isValidKioskRequestItem(items[2]))
        && (items.size() < 4 || isValidKioskRequestItem(items[3]))
        && (items.size() < 5 || isValidKioskRequestItem(items[4]))
        && (items.size() < 6 || isValidKioskRequestItem(items[5]))
        && (items.size() < 7 || isValidKioskRequestItem(items[6]))
        && (items.size() < 8 || isValidKioskRequestItem(items[7]))
        && (items.size() < 9 || isValidKioskRequestItem(items[8]))
        && (items.size() < 10 || isValidKioskRequestItem(items[9]));
    }

    function isValidKioskRequestItem(item) {
      return item is map
        && item.keys().hasOnly([
          "itemId", "itemName", "sku", "size", "replacementDays", "replacementReason",
          "durationRuleId", "durationRuleSource", "durationRuleSku", "durationRuleSapMaterial",
          "requiredQuantity", "requiredUnit", "chargeAmount", "signatureDataUrl", "earlyReplacementAlert"
        ])
        && item.itemId is string && item.itemId.size() > 0
        && item.itemName is string && item.itemName.size() > 0
        && item.sku is string && item.sku.size() > 0
        && item.size is string && item.size.size() > 0
        && item.replacementDays is int && item.replacementDays > 0
        && optionalString(item.durationRuleId)
        && optionalString(item.durationRuleSource)
        && optionalString(item.durationRuleSku)
        && optionalString(item.durationRuleSapMaterial)
        && (item.requiredQuantity == null || item.requiredQuantity is number)
        && optionalString(item.requiredUnit)
        && (item.chargeAmount == null || (item.chargeAmount is number && item.chargeAmount >= 0))
        && optionalString(item.signatureDataUrl)
        && (item.earlyReplacementAlert == null || item.earlyReplacementAlert is map)
        && (item.replacementReason == null || item.replacementReason in ["vida_util", "desgaste", "extravio"]);
    }

    function onlyAdminUpdatingKioskRequestStatus(newData, oldData) {
      let changedFields = newData.diff(oldData).affectedKeys();
      return changedFields.hasOnly(["status", "updatedAt", "plantaId"])
        && newData.status in ["pending", "approved", "rejected"];
    }

    function isValidKioskRequestStatus(data, requestId) {
      return data.keys().hasOnly(["requestId", "status", "source", "updatedAt", "plantaId"])
        && data.keys().hasAll(["requestId", "status", "source", "updatedAt"])
        && data.requestId == requestId
        && data.status in ["pending", "approved", "rejected"]
        && (data.plantaId == null || data.plantaId in ["cuautitlan", "toluca"])
        && data.source == "kiosk"
        && data.updatedAt is timestamp;
    }
  }
}
